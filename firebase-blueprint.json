{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about a registered user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier for the user." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's full name." },
        "photoURL": { "type": "string", "format": "uri", "description": "The user's profile picture URL." },
        "role": { "type": "string", "enum": ["admin", "client"], "description": "The user's role in the system." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the profile was created." }
      },
      "required": ["uid", "email", "role"]
    },
    "Quote": {
      "title": "Logistics Quote",
      "description": "A saved calculation for an import operation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID for the quote." },
        "userId": { "type": "string", "description": "The ID of the user who saved the quote." },
        "moeda": { "type": "string", "description": "Base currency." },
        "total": { "type": "number", "description": "Total investment value." },
        "tipoTransporte": { "type": "string", "enum": ["maritimo", "aereo"] },
        "produtos": { "type": "array", "description": "List of products in the quote." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "total", "moeda", "createdAt"]
    },
    "Tracking": {
      "title": "Tracking Information",
      "description": "Logistics tracking status.",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "history": { "type": "array" }
      },
      "required": ["status"]
    },
    "Settings": {
      "title": "Application Settings",
      "description": "Global application configurations, including lessons/courses metadata.",
      "type": "object",
      "properties": {
        "lessons": {
          "type": "array",
          "description": "List of lessons/courses with video IDs, titles, levels and summaries."
        }
      },
      "required": ["lessons"]
    },
    "DebitNote": {
      "title": "Debit Note",
      "description": "Information about a debit note generated.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The user who created the debit note." },
        "clientInfo": { "type": "string" },
        "operatorInfo": { "type": "string" },
        "idCode": { "type": "string" },
        "origin": { "type": "string" },
        "shipMode": { "type": "string" },
        "priceType": { "type": "string" },
        "paymentType": { "type": "string" },
        "items": { "type": "array" },
        "totalMZN": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "clientInfo", "totalMZN", "createdAt"]
    }
  },
  "firestore": {
    "/tracking/{trackingId}": {
      "schema": "Tracking",
      "description": "Cargo tracking status."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data."
    },
    "/quotes/{quoteId}": {
      "schema": "Quote",
      "description": "Saved logistics quotes."
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Global configuration documents like courses playlist."
    },
    "/debitNotes/{debitId}": {
      "schema": "DebitNote",
      "description": "Debit notes history for clients."
    }
  }
}
